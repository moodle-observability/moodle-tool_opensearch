          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"userid\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"userid\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
