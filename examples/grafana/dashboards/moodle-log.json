        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"contextinstanceid\", \"size\": 500, \"query\": \"contextlevel:70\"}",
        "definition": "{\"find\": \"terms\", \"field\": \"contextinstanceid\", \"size\": 500, \"query\": \"contextlevel:70\"}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
