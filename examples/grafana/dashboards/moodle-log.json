{
  "title": "Moodle - log (tool_opensearch)",
  "uid": "moodle-log",
  "tags": [
    "moodle",
    "opensearch"
  ],
  "description": "Moodle logs report filters over the logstore_opensearch data stream.",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-opensearch-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "shortname",
        "label": "Moodle",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"moodle.shortname\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"moodle.shortname\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "courseid",
        "label": "Course (id)",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"courseid\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"courseid\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
